# ---------------------------------------------------------------------------
# AquaLC — server secrets.  COPY to `.env`, fill in real values, NEVER commit.
# These are set on Supabase with:  supabase secrets set KEY=value
# ---------------------------------------------------------------------------

# Stripe — from Stripe Dashboard > Developers > API keys
#   test:  sk_test_...     live:  sk_live_...
STRIPE_SECRET_KEY=

# Stripe — from Dashboard > Developers > Webhooks > (your endpoint) > Signing secret
STRIPE_WEBHOOK_SECRET=

# Supabase — Project Settings > API
#   SUPABASE_URL and SUPABASE_ANON_KEY are also injected automatically into
#   Edge Functions, but listing them here keeps `supabase functions serve` happy.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service role key — Project Settings > API > service_role.  Used ONLY by the
# webhook.  Full database access, bypasses RLS.  Guard it like the Stripe key.
SUPABASE_SERVICE_ROLE_KEY=

# The public origin of the deployed app (for CORS + Stripe redirect URLs)
AQUA_APP_ORIGIN=https://aqualc.jebbario20.workers.dev
