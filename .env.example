# ---------------------------------------------------------------------------
# AquaLC — server secrets.  COPY to `.env`, fill in real values, NEVER commit.
# These are set on Supabase with:  supabase secrets set KEY=value
# ---------------------------------------------------------------------------

# Paddle — Developer Tools > Authentication > API keys
#   sandbox: pdl_sdbx_apikey_...     live: pdl_live_apikey_... (or similar)
PADDLE_API_KEY=

# "sandbox" while testing, "production" once live — drives both which Paddle
# API host Edge Functions call and how consume_quota()/the client interpret things.
PADDLE_ENVIRONMENT=sandbox

# Paddle — Developer Tools > Notifications > (your destination) > signing secret
# Sandbox and production destinations each have their OWN secret — do not
# reuse one across environments, and never recreate an existing destination
# (that rotates this value and breaks in-flight deliveries).
PADDLE_WEBHOOK_SECRET=

# Supabase — Project Settings > API
#   SUPABASE_URL and SUPABASE_ANON_KEY are also injected automatically into
#   Edge Functions, but listing them here keeps `supabase functions serve` happy.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service role key — Project Settings > API > service_role.  Used ONLY by the
# webhook.  Full database access, bypasses RLS.  Guard it like the Stripe key.
SUPABASE_SERVICE_ROLE_KEY=

# The public origin of the deployed app (for CORS)
AQUA_APP_ORIGIN=https://diaqualcolom.jebbario20.workers.dev
